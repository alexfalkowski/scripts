#!/usr/bin/env bash
# shellcheck disable=SC2155

# Dispatches afctl subcommands to their implementations in libexec.
set -eo pipefail

readonly script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
readonly libexec_dir="$script_dir/libexec"

usage() {
  cat >&2 <<'EOF'
usage: afctl <command> [args...]

Commands:
EOF

  for subcommand_path in "$libexec_dir"/*; do
    [ -x "$subcommand_path" ] || continue
    printf '  %s\n' "${subcommand_path##*/}" >&2
  done
  printf '  completion\n' >&2

  printf '\nSee %s/README.md for command details.\n' "$script_dir" >&2
  exit "${1:-1}"
}

# Prints the zsh completion script with this checkout's absolute path embedded.
completion() {
  if [ "$#" -ne 1 ] || [ "$1" != zsh ]; then
    echo "usage: afctl completion zsh" >&2
    return 1
  fi

  printf 'typeset -g _afctl_completion_dir=%q\n' "$script_dir"
  cat "$script_dir/completions/afctl.sh"
}

readonly command="${1:-}"

case "$command" in
'' | help | -h | --help)
  usage 0
  ;;
completion)
  shift
  completion "$@"
  exit 0
  ;;
*[!a-z0-9-]*)
  printf 'unknown command: %s\n' "$command" >&2
  usage
  ;;
esac

readonly command_path="$libexec_dir/$command"

if [ ! -x "$command_path" ]; then
  printf 'unknown command: %s\n' "$command" >&2
  usage
fi

shift
PATH="$libexec_dir:$PATH" exec "$command_path" "$@"
